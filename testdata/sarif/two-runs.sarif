{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "first-tool",
          "version": "1.2.3",
          "informationUri": "https://example.com/first-tool?a=1&b=<2>",
          "rules": [
            { "id": "R1", "shortDescription": { "text": "Rule one" },
              "defaultConfiguration": { "level": "error" },
              "properties": { "security-severity": "8.1", "tags": ["security", "CWE-89"], "precision": 0.95 } }
          ]
        }
      },
      "invocations": [ { "executionSuccessful": true } ],
      "results": [
        {
          "ruleId": "R1",
          "ruleIndex": 0,
          "level": "error",
          "message": { "text": "Line \"one\" é & <b>" },
          "locations": [
            { "id": 0,
              "physicalLocation": {
                "artifactLocation": { "uri": "src/db.py", "index": 0 },
                "region": { "startLine": 10, "startColumn": 5, "endLine": 10, "endColumn": 42 }
              },
              "logicalLocations": [ { "fullyQualifiedName": "db.query" } ] }
          ],
          "partialFingerprints": { "primaryLocationLineHash": "abc123:1" },
          "fingerprints": { "matchBasedId/v1": "0f1e2d3c" },
          "properties": { "confidence": 1e2, "nested": { "list": [1, 2.50, null, true] } }
        }
      ],
      "artifacts": [ { "location": { "uri": "src/db.py" } } ],
      "columnKind": "utf16CodeUnits"
    },
    {
      "tool": { "driver": { "name": "second-tool" } },
      "results": null
    }
  ],
  "properties": { "top": "level" }
}
